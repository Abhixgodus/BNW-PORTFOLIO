---
import "../styles/utilities.css";
import "../styles/concept.css";
import "../styles/home-journal.css";
import "../styles/editorial-about.css";
import "../styles/editorial-contact.css";
import "../styles/editorial-photo-motion.css";
import "../styles/editorial-journal.css";
import "../styles/home-hero.css";
import EditorialSite from "../components/editorial/EditorialSite.jsx";
import heroPhotographs from "../data/home-hero.json";
const { page = "home", post = null } = Astro.props;
const firstHero = `/_concept/hero/${heroPhotographs[0].slug}`;
const labels = { home: "Photography", gallery: "Gallery", about: "About", contact: "Inquire", blog: "The Blog", post: post?.title };
const descriptions = {
  home: "Street and landscape photographs by Abhimanyu Sharma, based in Kolkata, India.",
  gallery: "Seven photographic collections and selected colour and monochrome photographs by Abhimanyu Sharma.",
  about: "Abhimanyu Sharma, an engineering student and photographer from Kolkata, India.",
  contact: "Contact Abhimanyu Sharma about photographs, prints and projects.",
  blog: "Photographs and notes from walks around Kolkata and travels in Delhi and Sikkim, by Abhimanyu Sharma.",
  post: post?.excerpt,
};
---
<!doctype html>
<html lang="en" data-editorial-page={page}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("ed-js");
      window.setTimeout(() => {
        const site = document.querySelector(".ed-site");
        if (site && !site.classList.contains("is-ready"))
          document.documentElement.classList.add("ed-entry-timeout");
      }, 6000);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={descriptions[page]} />
    <meta property="og:title" content={`${labels[page]} — Abhimanyu Sharma`} />
    <meta property="og:description" content={descriptions[page]} />
    <meta property="og:type" content={page === "post" ? "article" : "website"} />
    <title>{labels[page]} — Abhimanyu Sharma</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" href="/fonts/raleway-variable-latin.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/brittany-signature-script.ttf" type="font/ttf" crossorigin />
    {page === "home" && <link rel="preload" as="font" href="/fonts/la-luxes-serif.woff" type="font/woff" crossorigin />}
    {page === "home" && <link rel="preload" as="font" href="/fonts/la-luxes-script.woff" type="font/woff" crossorigin />}
    <link rel="preload" as="font" href="/fonts/cormorant-unicase-regular-latin.woff2" type="font/woff2" crossorigin />
    {page === "home" && <link rel="preload" as="image" href={`${firstHero}-desktop-1920.webp`} imagesrcset={`${firstHero}-desktop-1280.webp 1280w, ${firstHero}-desktop-1920.webp 1920w, ${firstHero}-desktop-2560.webp 2560w`} imagesizes="100vw" media="(min-width:761px), (orientation:landscape)" fetchpriority="high" />}
    {page === "home" && <link rel="preload" as="image" href={`${firstHero}-phone-960.webp`} imagesrcset={`${firstHero}-phone-640.webp 640w, ${firstHero}-phone-960.webp 960w`} imagesizes="100vw" media="(max-width:760px) and (orientation:portrait)" fetchpriority="high" />}
  </head>
  <body>
    <EditorialSite page={page} post={post} client:load />
  </body>
</html>
